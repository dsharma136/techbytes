BRAVE_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: lower if still hitting TPM (default processor ceiling is 7000)
# TOKEN_BUDGET_CEILING=7000
# GROQ_REASONING_EFFORT=low

# Target cards per topic category (default 12). Min publish floor is 5; aim ≥35 total.
# CATEGORY_CARD_QUOTA=12
# MIN_CATEGORY_CARDS=5
# MIN_TOTAL_CARDS=35
# ARTICLES_PER_CATEGORY=24

# Only articles newer than this many days enter clustering (default 3).
# Widens per category up to CLUSTER_MAX_AGE_CAP when a topic is short.
# CLUSTER_MAX_AGE_DAYS=3
# CLUSTER_MAX_AGE_CAP=7

# Upstash Redis (Vercel KV). When set, feeds are stored in Redis instead of disk.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protects POST /api/cards/refresh and GET /api/cron/generate
CRON_SECRET=

# Optional: comma-separated browser origins for CORS (e.g. https://your-app.vercel.app)
CORS_ORIGINS=
FRONTEND_ORIGIN=
